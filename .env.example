# --- Database -------------------------------------------------------------
# PostgreSQL connection string. Leave EMPTY in local development to use the
# embedded PGlite database stored in ./.data/pglite (no installation needed).
# With docker compose this is set for you.
DATABASE_URL=

# Password for the bundled PostgreSQL container (docker compose only).
POSTGRES_PASSWORD=

# --- Auth (Better Auth) ----------------------------------------------------
# Long random string: `openssl rand -base64 32`. REQUIRED in production.
BETTER_AUTH_SECRET=
# Public origin of the site, e.g. https://menu.example.com (http://localhost:3000 in dev).
BETTER_AUTH_URL=http://localhost:3000

# --- Production domain (docker compose + Caddy automatic HTTPS) -------------
# DNS A record for this name must point at your server. HTTPS is required for AR (WebXR/camera).
DOMAIN=menu.example.com

# --- Uploaded dish media (.glb / .usdz / images) ----------------------------
# Directory on disk (a Docker volume in production).
UPLOAD_DIR=./.data/uploads

# --- Seeding (npm run db:seed) ----------------------------------------------
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-long-password
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
# Historical fake orders and dish events for the analytics dashboard.
# Skipped when NODE_ENV=production unless this is "true".
SEED_DEMO_DATA=false
